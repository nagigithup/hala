 "font_size": 12,
 "html": "<style>\n@page{size:80mm 297mm;margin:0}html,body,.print-format{width:80mm!important;min-width:80mm!important;max-width:80mm!important;margin:0!important;padding:0!important}.hala-receipt-print{width:74mm;margin:0 auto;padding:2mm 0 3mm;direction:rtl;text-align:right;color:#000;font-family:\"Noto Naskh Arabic\",\"DejaVu Sans\",Arial,sans-serif;font-size:14px;font-weight:700;line-height:1.55}.logo{text-align:center}.logo img{max-width:38mm;max-height:20mm}.center{text-align:center}.title{font-size:20px;margin:4px 0}.line{border-top:1px dashed #000;margin:7px 0}.info{width:100%;border-collapse:collapse;table-layout:fixed}.info td{padding:3px 1px;vertical-align:top;border:0}.label{width:34%}.value{width:66%;overflow-wrap:anywhere}.number{direction:ltr;unicode-bidi:isolate;text-align:left}.amount{font-size:18px;border-top:1px solid #000;border-bottom:1px solid #000;padding:6px 1px;margin:5px 0}.words,.remarks{padding:5px;border:1px solid #000;margin-top:6px}.refs{width:100%;border-collapse:collapse;margin-top:5px}.refs td{padding:3px 1px;border-bottom:1px dashed #999}.footer{text-align:center;border-top:2px solid #000;margin-top:10px;padding-top:7px}@media print{tr,td{page-break-inside:avoid!important;break-inside:avoid!important}}\n.print-format{min-height:0!important;height:auto!important}.hala-receipt-print .info td{white-space:normal!important;overflow-wrap:anywhere!important;vertical-align:top!important}.hala-receipt-print .info td.label{display:table-cell!important;width:36%!important;text-align:right!important;font-size:12px!important;line-height:1.5!important}.hala-receipt-print .info td.value{display:table-cell!important;width:64%!important;font-size:14px!important;line-height:1.5!important;word-break:break-word!important;unicode-bidi:plaintext}</style>\n{% set request = disbursement_print_data(doc) %}\n{% set company = frappe.get_doc(\"Company\", doc.company) %}\n{% set cashier_name = frappe.db.get_value(\"User\", request.cashier, \"full_name\") or request.cashier %}\n<div class=\"hala-receipt-print\">\n{% if company.company_logo %}<div class=\"logo\"><img src=\"{{ company.company_logo | e }}\"></div>{% endif %}\n<div class=\"center\">{{ (company.company_name or doc.company) | e }}</div>\n<div class=\"center title\">سند صرف</div><div class=\"line\"></div>\n<table class=\"info\">\n{% for label, value in [(\"رقم السند\", request.name), (\"التاريخ\", request.posting_date), (\"نوع الصرف\", request.kind), (\"المستفيد\", request.beneficiary), (\"الكاشير\", cashier_name), (\"طريقة الدفع\", request.mode_of_payment), (\"المستند المحاسبي\", doc.name), (\"المرجع الأصلي\", request.source_name or request.employee_advance or \"\")] %}\n{% if value %}<tr><td class=\"label\">{{ label }}</td><td class=\"value\">{{ value | e }}</td></tr>{% endif %}\n{% endfor %}</table>\n<div class=\"amount\">المبلغ المصروف: {{ frappe.utils.fmt_money(request.amount, currency=request.currency) }}</div>\n<div class=\"remarks\">البيان: {{ request.description | e }}</div>\n<div class=\"footer\">توقيع المستلم: ................................</div>\n</div>",
 "line_breaks": 0,
 "margin_bottom": 0.0,
 "margin_left": 0.0,
 "margin_right": 0.0,
 "margin_top": 0.0,
 "module": "Hala",
 "name": "Hala Disbursement Payment",
 "page_number": "Hide",
 "pdf_generator": "chrome",
 "print_format_builder": 0,
 "print_format_builder_beta": 0,
 "print_format_for": "DocType",
 "print_format_type": "Jinja",
 "raw_printing": 0,
 "show_section_headings": 0,
 "standard": "Yes"
}
