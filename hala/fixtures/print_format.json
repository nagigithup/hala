  "html": "<style>\r\n\r\n/* =========================================================\r\n   PAGE SIZE\r\n========================================================= */\r\n\r\n@page {\r\n    size: 80mm 297mm !important;\r\n    margin: 0 !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   FRAPPE / PAGE RESET\r\n========================================================= */\r\n\r\nhtml,\r\nbody,\r\n.print-format {\r\n    width: 80mm !important;\r\n    min-width: 80mm !important;\r\n    max-width: 80mm !important;\r\n\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n\r\n    background: #fff !important;\r\n}\r\n\r\n\r\n.print-format {\r\n    color: #000 !important;\r\n\r\n    font-family:\r\n        \"Noto Naskh Arabic\",\r\n        \"DejaVu Sans\",\r\n        Arial,\r\n        sans-serif !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   FRAPPE / BOOTSTRAP TABLE RESET\r\n========================================================= */\r\n\r\n.print-format table {\r\n    width: 100% !important;\r\n\r\n    margin: 0 !important;\r\n\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n}\r\n\r\n\r\n.print-format table,\r\n.print-format thead,\r\n.print-format tbody,\r\n.print-format tr,\r\n.print-format th,\r\n.print-format td {\r\n    background: transparent !important;\r\n    box-shadow: none !important;\r\n}\r\n\r\n\r\n.print-format td,\r\n.print-format th {\r\n    border: none !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   MAIN RECEIPT\r\n========================================================= */\r\n\r\n.receipt {\r\n    width: 74mm !important;\r\n    max-width: 74mm !important;\r\n\r\n    margin: 0 auto !important;\r\n\r\n    padding: 2mm 0 3mm 0 !important;\r\n\r\n    box-sizing: border-box;\r\n\r\n    direction: rtl;\r\n    text-align: right;\r\n\r\n    line-height: 1.55;\r\n\r\n    overflow: hidden;\r\n\r\n    color: #000 !important;\r\n    font-size: 16px !important;\r\n    font-weight: 700 !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   ALL TEXT\r\n========================================================= */\r\n\r\n.receipt *:not(img) {\r\n    color: #000 !important;\r\n    font-size: 16px !important;\r\n    font-weight: 700 !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   COMMON\r\n========================================================= */\r\n\r\n.bold {\r\n    font-weight: 700 !important;\r\n}\r\n\r\n\r\n.center {\r\n    text-align: center !important;\r\n}\r\n\r\n\r\n.number {\r\n    direction: ltr !important;\r\n    unicode-bidi: isolate !important;\r\n\r\n    font-family:\r\n        \"DejaVu Sans\",\r\n        Arial,\r\n        sans-serif !important;\r\n}\r\n\r\n\r\n/* dashed separator */\r\n\r\n.line {\r\n    width: 100%;\r\n    height: 0;\r\n\r\n    border-top: 1px dashed #000;\r\n\r\n    margin: 5px 0;\r\n}\r\n\r\n\r\n/* solid separator */\r\n\r\n.line-solid {\r\n    width: 100%;\r\n    height: 0;\r\n\r\n    border-top: 1px solid #000;\r\n\r\n    margin: 5px 0;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   LOGO\r\n========================================================= */\r\n\r\n.logo {\r\n    text-align: center;\r\n\r\n    margin: 0 0 3px 0;\r\n}\r\n\r\n\r\n.logo img {\r\n    display: block;\r\n\r\n    width: auto !important;\r\n    height: auto !important;\r\n\r\n    max-width: 38mm !important;\r\n    max-height: 20mm !important;\r\n\r\n    margin: 0 auto !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   COMPANY HEADER\r\n========================================================= */\r\n\r\n.company-name {\r\n    text-align: center;\r\n\r\n    line-height: 1.5;\r\n\r\n    padding: 0 2mm;\r\n\r\n    margin: 2px 0;\r\n}\r\n\r\n\r\n.invoice-title {\r\n    text-align: center;\r\n\r\n    margin: 3px 0 4px 0;\r\n}\r\n\r\n\r\n.tax-id {\r\n    text-align: center;\r\n\r\n    margin: 2px 0 5px 0;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   INVOICE INFORMATION\r\n========================================================= */\r\n\r\n.info-table {\r\n    width: 100% !important;\r\n\r\n    table-layout: fixed !important;\r\n\r\n    direction: rtl !important;\r\n\r\n    margin: 0 !important;\r\n}\r\n\r\n\r\n.info-table td {\r\n    padding: 2px 1px !important;\r\n\r\n    border: 0 !important;\r\n\r\n    vertical-align: top !important;\r\n\r\n    line-height: 1.45;\r\n}\r\n\r\n\r\n/* title column */\r\n\r\n.info-label {\r\n    width: 25mm !important;\r\n\r\n    text-align: right !important;\r\n\r\n    white-space: nowrap !important;\r\n}\r\n\r\n\r\n/* value column */\r\n\r\n.info-value {\r\n    width: auto !important;\r\n\r\n    text-align: right !important;\r\n\r\n    overflow-wrap: anywhere !important;\r\n    word-break: break-word !important;\r\n}\r\n\r\n\r\n/* invoice number / date / time */\r\n\r\n.info-number {\r\n    direction: ltr !important;\r\n    unicode-bidi: isolate !important;\r\n\r\n    text-align: left !important;\r\n\r\n    padding-left: 2mm !important;\r\n\r\n    white-space: normal !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   ITEMS TABLE\r\n========================================================= */\r\n\r\n.items {\r\n    width: 100% !important;\r\n\r\n    table-layout: fixed !important;\r\n\r\n    direction: rtl !important;\r\n\r\n    margin: 0 !important;\r\n}\r\n\r\n\r\n/* table header */\r\n\r\n.items thead th {\r\n    padding: 4px 1px !important;\r\n\r\n    border-top: 1px solid #000 !important;\r\n    border-bottom: 1px solid #000 !important;\r\n\r\n    text-align: center !important;\r\n\r\n    vertical-align: middle !important;\r\n}\r\n\r\n\r\n/* item */\r\n\r\n.items .col-item {\r\n    width: 43% !important;\r\n\r\n    text-align: right !important;\r\n}\r\n\r\n\r\n/* qty */\r\n\r\n.items .col-qty {\r\n    width: 14% !important;\r\n}\r\n\r\n\r\n/* price */\r\n\r\n.items .col-price {\r\n    width: 20% !important;\r\n}\r\n\r\n\r\n/* total */\r\n\r\n.items .col-total {\r\n    width: 23% !important;\r\n}\r\n\r\n\r\n/* rows */\r\n\r\n.items tbody td {\r\n    padding: 5px 1px !important;\r\n\r\n    border: none !important;\r\n\r\n    border-bottom: 1px dashed #ccc !important;\r\n\r\n    vertical-align: top !important;\r\n}\r\n\r\n\r\n.items tbody td.col-item {\r\n    text-align: right !important;\r\n\r\n    overflow-wrap: anywhere !important;\r\n\r\n    word-break: normal !important;\r\n\r\n    line-height: 1.5;\r\n}\r\n\r\n\r\n.items tbody td.col-qty,\r\n.items tbody td.col-price,\r\n.items tbody td.col-total {\r\n\r\n    direction: ltr !important;\r\n\r\n    unicode-bidi: isolate !important;\r\n\r\n    text-align: center !important;\r\n\r\n    white-space: nowrap !important;\r\n\r\n    font-family:\r\n        \"DejaVu Sans\",\r\n        Arial,\r\n        sans-serif !important;\r\n}\r\n\r\n\r\n/* item notes */\r\n\r\n.item-note {\r\n    margin-top: 1px;\r\n\r\n    line-height: 1.4;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   TOTALS\r\n========================================================= */\r\n\r\n.totals {\r\n    width: 100% !important;\r\n\r\n    table-layout: fixed !important;\r\n\r\n    direction: rtl !important;\r\n\r\n    margin-top: 2px !important;\r\n}\r\n\r\n\r\n.totals td {\r\n    padding: 3px 1px !important;\r\n\r\n    border: none !important;\r\n\r\n    vertical-align: middle !important;\r\n}\r\n\r\n\r\n/* label */\r\n\r\n.totals-label {\r\n    width: 57% !important;\r\n\r\n    text-align: right !important;\r\n}\r\n\r\n\r\n/* amount */\r\n\r\n.totals-value {\r\n    width: 43% !important;\r\n\r\n    direction: ltr !important;\r\n\r\n    unicode-bidi: isolate !important;\r\n\r\n    text-align: left !important;\r\n\r\n    padding-left: 2mm !important;\r\n\r\n    white-space: nowrap !important;\r\n\r\n    font-family:\r\n        \"DejaVu Sans\",\r\n        Arial,\r\n        sans-serif !important;\r\n}\r\n\r\n\r\n/* GRAND TOTAL */\r\n\r\n.grand-total td {\r\n    padding-top: 5px !important;\r\n    padding-bottom: 5px !important;\r\n\r\n    border-top: 1px solid #000 !important;\r\n    border-bottom: 1px solid #000 !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   PAYMENTS\r\n========================================================= */\r\n\r\n.payments {\r\n    width: 100% !important;\r\n\r\n    table-layout: fixed !important;\r\n\r\n    direction: rtl !important;\r\n}\r\n\r\n\r\n.payments td {\r\n    padding: 3px 1px !important;\r\n\r\n    border: none !important;\r\n\r\n    vertical-align: middle !important;\r\n}\r\n\r\n\r\n/* payment name */\r\n\r\n.payment-label {\r\n    width: 57% !important;\r\n\r\n    text-align: right !important;\r\n}\r\n\r\n\r\n/* payment value */\r\n\r\n.payment-value {\r\n    width: 43% !important;\r\n\r\n    direction: ltr !important;\r\n\r\n    unicode-bidi: isolate !important;\r\n\r\n    text-align: left !important;\r\n\r\n    padding-left: 2mm !important;\r\n\r\n    white-space: nowrap !important;\r\n\r\n    font-family:\r\n        \"DejaVu Sans\",\r\n        Arial,\r\n        sans-serif !important;\r\n}\r\n\r\n\r\n.change-row {\r\n    font-weight: 700 !important;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   QR CODE\r\n========================================================= */\r\n\r\n.qr-section {\r\n    text-align: center;\r\n\r\n    margin-top: 8px;\r\n}\r\n\r\n\r\n.qr-section img {\r\n    display: block;\r\n\r\n    width: 30mm !important;\r\n    height: 30mm !important;\r\n\r\n    margin: 0 auto !important;\r\n}\r\n\r\n\r\n.qr-tax {\r\n    text-align: center;\r\n\r\n    margin-top: 3px;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   FOOTER\r\n========================================================= */\r\n\r\n.footer {\r\n    text-align: center;\r\n\r\n    margin-top: 7px;\r\n    margin-bottom: 2px;\r\n}\r\n\r\n\r\n/* =========================================================\r\n   PRINT SETTINGS\r\n========================================================= */\r\n\r\n@media print {\r\n\r\n    @page {\r\n        size: 80mm 297mm !important;\r\n        margin: 0 !important;\r\n    }\r\n\r\n\r\n    html,\r\n    body,\r\n    .print-format {\r\n\r\n        width: 80mm !important;\r\n\r\n        min-width: 80mm !important;\r\n        max-width: 80mm !important;\r\n\r\n        margin: 0 !important;\r\n\r\n        padding: 0 !important;\r\n    }\r\n\r\n\r\n    .receipt {\r\n\r\n        width: 74mm !important;\r\n\r\n        max-width: 74mm !important;\r\n\r\n        margin: 0 auto !important;\r\n    }\r\n\r\n\r\n    tr,\r\n    td,\r\n    th {\r\n\r\n        page-break-inside: avoid !important;\r\n\r\n        break-inside: avoid !important;\r\n    }\r\n\r\n}\r\n\r\n</style>\r\n\r\n\r\n{# =========================================================\r\n   BASIC DATA\r\n========================================================= #}\r\n\r\n{%- set currency =\r\n    frappe.db.get_value(\r\n        \"Currency\",\r\n        doc.currency,\r\n        \"symbol\"\r\n    ) or doc.currency\r\n-%}\r\n\r\n\r\n{%- set company_tax_id =\r\n    frappe.db.get_value(\r\n        \"Company\",\r\n        doc.company,\r\n        \"tax_id\"\r\n    )\r\n-%}\r\n\r\n\r\n{%- set company_logo =\r\n    frappe.db.get_value(\r\n        \"Company\",\r\n        doc.company,\r\n        \"company_logo\"\r\n    )\r\n-%}\r\n\r\n\r\n{%- set cashier_name =\r\n    frappe.db.get_value(\r\n        \"User\",\r\n        doc.owner,\r\n        \"full_name\"\r\n    ) or doc.owner\r\n-%}\r\n\r\n\r\n\r\n{# =========================================================\r\n   TAX\r\n   الأسعار شاملة الضريبة\r\n========================================================= #}\r\n\r\n{%- set grand_total =\r\n    doc.grand_total or 0\r\n-%}\r\n\r\n\r\n{%- if\r\n    doc.total_taxes_and_charges\r\n    and\r\n    doc.total_taxes_and_charges > 0\r\n-%}\r\n\r\n    {%- set tax_amount =\r\n        doc.total_taxes_and_charges\r\n    -%}\r\n\r\n{%- else -%}\r\n\r\n    {%- set tax_amount =\r\n        grand_total * 15 / 115\r\n    -%}\r\n\r\n{%- endif -%}\r\n\r\n\r\n{%- set net_total_excluding_tax =\r\n    grand_total - tax_amount\r\n-%}\r\n\r\n\r\n\r\n{# =========================================================\r\n   PAYMENTS\r\n========================================================= #}\r\n\r\n{%- set ns =\r\n    namespace(\r\n        payments_total=0\r\n    )\r\n-%}\r\n\r\n\r\n{%- for payment in doc.payments or [] -%}\r\n\r\n    {%- set ns.payments_total =\r\n        ns.payments_total\r\n        +\r\n        (payment.amount or 0)\r\n    -%}\r\n\r\n{%- endfor -%}\r\n\r\n\r\n\r\n{# =========================================================\r\n   TENDERED AMOUNT\r\n========================================================= #}\r\n\r\n{%- set tendered_amount =\r\n    doc.get(\"custom_tendered_amount\")\r\n-%}\r\n\r\n\r\n{%- if tendered_amount is none -%}\r\n\r\n    {%- set tendered_amount =\r\n        ns.payments_total\r\n    -%}\r\n\r\n{%- endif -%}\r\n\r\n\r\n\r\n{# =========================================================\r\n   CHANGE\r\n========================================================= #}\r\n\r\n{%- set change_returned =\r\n    tendered_amount - grand_total\r\n-%}\r\n\r\n\r\n{%- if change_returned < 0 -%}\r\n\r\n    {%- set change_returned = 0 -%}\r\n\r\n{%- endif -%}\r\n\r\n\r\n\r\n<!-- ========================================================\r\n     RECEIPT START\r\n======================================================== -->\r\n\r\n<div class=\"receipt\">\r\n\r\n\r\n<!-- ========================================================\r\n     LOGO\r\n======================================================== -->\r\n\r\n{% if company_logo %}\r\n\r\n<div class=\"logo\">\r\n\r\n    <img\r\n        src=\"{{ company_logo }}\"\r\n        alt=\"\"\r\n    >\r\n\r\n</div>\r\n\r\n{% endif %}\r\n\r\n\r\n\r\n<!-- ========================================================\r\n     COMPANY\r\n======================================================== -->\r\n\r\n<div class=\"company-name\">\r\n\r\n    {{ doc.company }}\r\n\r\n</div>\r\n\r\n\r\n\r\n<div class=\"invoice-title\">\r\n\r\n    فاتورة ضريبية مبسطة\r\n\r\n</div>\r\n\r\n\r\n\r\n{% if company_tax_id %}\r\n\r\n<div class=\"tax-id\">\r\n\r\n    الرقم الضريبي:\r\n\r\n    <span class=\"number\">\r\n        {{ company_tax_id }}\r\n    </span>\r\n\r\n</div>\r\n\r\n{% endif %}\r\n\r\n\r\n\r\n<div class=\"line\"></div>\r\n\r\n\r\n\r\n<!-- ========================================================\r\n     INVOICE INFORMATION\r\n======================================================== -->\r\n\r\n<table class=\"info-table\">\r\n\r\n    <tbody>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label\">\r\n                رقم الفاتورة\r\n            </td>\r\n\r\n            <td class=\"info-value info-number\">\r\n                {{ doc.name }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label\">\r\n                التاريخ\r\n            </td>\r\n\r\n            <td class=\"info-value info-number\">\r\n\r\n                {{ frappe.utils.formatdate(\r\n                    doc.posting_date,\r\n                    \"dd-MM-yyyy\"\r\n                ) }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n\r\n        {% if doc.posting_time %}\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label\">\r\n                الوقت\r\n            </td>\r\n\r\n            <td class=\"info-value info-number\">\r\n\r\n                {{\r\n                    (doc.posting_time|string)\r\n                    .split('.')[0]\r\n                }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        {% endif %}\r\n\r\n\r\n\r\n        {% if doc.customer_name %}\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label\">\r\n                العميل\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n\r\n                {{ doc.customer_name }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        {% endif %}\r\n\r\n\r\n\r\n        {% if cashier_name %}\r\n\r\n        <tr>\r\n\r\n            <td class=\"info-label\">\r\n                الكاشير\r\n            </td>\r\n\r\n            <td class=\"info-value\">\r\n\r\n                {{ cashier_name }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        {% endif %}\r\n\r\n\r\n    </tbody>\r\n\r\n</table>\r\n\r\n\r\n\r\n<div class=\"line\"></div>\r\n\r\n\r\n\r\n<!-- ========================================================\r\n     ITEMS\r\n======================================================== -->\r\n\r\n<table class=\"items\">\r\n\r\n\r\n    <thead>\r\n\r\n        <tr>\r\n\r\n            <th class=\"col-item\">\r\n                الصنف\r\n            </th>\r\n\r\n            <th class=\"col-qty\">\r\n                الكمية\r\n            </th>\r\n\r\n            <th class=\"col-price\">\r\n                السعر\r\n            </th>\r\n\r\n            <th class=\"col-total\">\r\n                الإجمالي\r\n            </th>\r\n\r\n        </tr>\r\n\r\n    </thead>\r\n\r\n\r\n\r\n    <tbody>\r\n\r\n\r\n        {% for item in doc.items %}\r\n\r\n\r\n        <tr>\r\n\r\n\r\n            <!-- ITEM -->\r\n\r\n            <td class=\"col-item\">\r\n\r\n                <div class=\"item-name\">\r\n\r\n                    {{ item.item_name }}\r\n\r\n                </div>\r\n\r\n\r\n\r\n                {% if item.is_free_item %}\r\n\r\n                <div class=\"item-note\">\r\n\r\n                    مجاني\r\n\r\n                </div>\r\n\r\n                {% endif %}\r\n\r\n\r\n\r\n                {% if\r\n                    item.discount_percentage\r\n                    and\r\n                    item.discount_percentage > 0\r\n                %}\r\n\r\n                <div class=\"item-note\">\r\n\r\n                    خصم\r\n\r\n                    <span class=\"number\">\r\n\r\n                        {{\r\n                            \"%.1f\"|format(\r\n                                item.discount_percentage\r\n                            )\r\n                        }}%\r\n\r\n                    </span>\r\n\r\n                </div>\r\n\r\n                {% endif %}\r\n\r\n\r\n\r\n                {% if item.serial_no %}\r\n\r\n                <div class=\"item-note\">\r\n\r\n                    الرقم التسلسلي:\r\n\r\n                    <span class=\"number\">\r\n\r\n                        {{\r\n                            item.serial_no\r\n                            |replace(\"\\n\", \", \")\r\n                        }}\r\n\r\n                    </span>\r\n\r\n                </div>\r\n\r\n                {% endif %}\r\n\r\n            </td>\r\n\r\n\r\n\r\n            <!-- QTY -->\r\n\r\n            <td class=\"col-qty\">\r\n\r\n                {{\r\n                    \"%.2f\"|format(\r\n                        item.qty or 0\r\n                    )\r\n                }}\r\n\r\n            </td>\r\n\r\n\r\n\r\n            <!-- PRICE -->\r\n\r\n            <td class=\"col-price\">\r\n\r\n                {{\r\n                    \"%.2f\"|format(\r\n                        item.rate or 0\r\n                    )\r\n                }}\r\n\r\n            </td>\r\n\r\n\r\n\r\n            <!-- TOTAL -->\r\n\r\n            <td class=\"col-total bold\">\r\n\r\n                {{\r\n                    \"%.2f\"|format(\r\n                        item.amount or 0\r\n                    )\r\n                }}\r\n\r\n            </td>\r\n\r\n\r\n        </tr>\r\n\r\n\r\n        {% endfor %}\r\n\r\n\r\n    </tbody>\r\n\r\n\r\n</table>\r\n\r\n\r\n\r\n<!-- ========================================================\r\n     TOTALS\r\n======================================================== -->\r\n<div class=\"line\"></div>\r\n\r\n<table class=\"totals\">\r\n\r\n    <tbody>\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"totals-label\">\r\n\r\n                المجموع قبل الضريبة\r\n\r\n            </td>\r\n\r\n\r\n            <td class=\"totals-value\">\r\n\r\n                {{\r\n                    \"%.2f\"|format(\r\n                        net_total_excluding_tax\r\n                    )\r\n                }}\r\n\r\n                {{ currency }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"totals-label\">\r\n\r\n                الضريبة 15%\r\n\r\n            </td>\r\n\r\n\r\n            <td class=\"totals-value\">\r\n\r\n                {{\r\n                    \"%.2f\"|format(\r\n                        tax_amount\r\n                    )\r\n                }}\r\n\r\n                {{ currency }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n\r\n        {% if\r\n            doc.discount_amount\r\n            and\r\n            doc.discount_amount > 0\r\n        %}\r\n\r\n        <tr>\r\n\r\n            <td class=\"totals-label\">\r\n\r\n                الخصم\r\n\r\n            </td>\r\n\r\n\r\n            <td class=\"totals-value\">\r\n\r\n                -\r\n                {{\r\n                    \"%.2f\"|format(\r\n                        doc.discount_amount\r\n                    )\r\n                }}\r\n\r\n                {{ currency }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        {% endif %}\r\n\r\n\r\n\r\n        <tr class=\"grand-total\">\r\n\r\n            <td class=\"totals-label\">\r\n\r\n                الإجمالي شامل الضريبة\r\n\r\n            </td>\r\n\r\n\r\n            <td class=\"totals-value\">\r\n\r\n                {{\r\n                    \"%.2f\"|format(\r\n                        grand_total\r\n                    )\r\n                }}\r\n\r\n                {{ currency }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n    </tbody>\r\n\r\n</table>\r\n\r\n\r\n\r\n<!-- ========================================================\r\n     PAYMENTS\r\n======================================================== -->\r\n\r\n{% if doc.payments %}\r\n\r\n\r\n<div class=\"line\"></div>\r\n\r\n\r\n\r\n<table class=\"payments\">\r\n\r\n    <tbody>\r\n\r\n\r\n        {% for payment in doc.payments %}\r\n\r\n\r\n            {% if\r\n                payment.amount\r\n                and\r\n                payment.amount != 0\r\n            %}\r\n\r\n\r\n            <tr>\r\n\r\n\r\n                <td class=\"payment-label\">\r\n\r\n                    {{ payment.mode_of_payment }}\r\n\r\n                </td>\r\n\r\n\r\n                <td class=\"payment-value\">\r\n\r\n                    {{\r\n                        \"%.2f\"|format(\r\n                            payment.amount\r\n                        )\r\n                    }}\r\n\r\n                    {{ currency }}\r\n\r\n                </td>\r\n\r\n\r\n            </tr>\r\n\r\n\r\n            {% endif %}\r\n\r\n\r\n        {% endfor %}\r\n\r\n\r\n\r\n        <tr>\r\n\r\n            <td class=\"payment-label\">\r\n\r\n                المبلغ المستلم\r\n\r\n            </td>\r\n\r\n\r\n            <td class=\"payment-value\">\r\n\r\n                {{\r\n                    \"%.2f\"|format(\r\n                        tendered_amount\r\n                    )\r\n                }}\r\n\r\n                {{ currency }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n\r\n        {% if change_returned > 0 %}\r\n\r\n\r\n        <tr class=\"change-row\">\r\n\r\n            <td class=\"payment-label\">\r\n\r\n                الباقي للعميل\r\n\r\n            </td>\r\n\r\n\r\n            <td class=\"payment-value\">\r\n\r\n                {{\r\n                    \"%.2f\"|format(\r\n                        change_returned\r\n                    )\r\n                }}\r\n\r\n                {{ currency }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        {% endif %}\r\n\r\n\r\n\r\n        {% if\r\n            doc.outstanding_amount\r\n            and\r\n            doc.outstanding_amount > 0\r\n        %}\r\n\r\n\r\n        <tr class=\"bold\">\r\n\r\n            <td class=\"payment-label\">\r\n\r\n                المبلغ المتبقي\r\n\r\n            </td>\r\n\r\n\r\n            <td class=\"payment-value\">\r\n\r\n                {{\r\n                    \"%.2f\"|format(\r\n                        doc.outstanding_amount\r\n                    )\r\n                }}\r\n\r\n                {{ currency }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        {% endif %}\r\n\r\n\r\n    </tbody>\r\n\r\n</table>\r\n\r\n\r\n{% endif %}\r\n\r\n\r\n\r\n<!-- ========================================================\r\n     QR CODE\r\n======================================================== -->\r\n\r\n{% if doc.name %}\r\n\r\n\r\n<div class=\"qr-section\">\r\n\r\n\r\n    <img\r\n        src=\"data:image/png;base64,{{ get_zatca_phase_1_qr_for_invoice(doc.name) }}\"\r\n        alt=\"\"\r\n    >\r\n\r\n\r\n\r\n\r\n</div>\r\n\r\n\r\n{% endif %}\r\n\r\n\r\n\r\n<!-- ========================================================\r\n     FOOTER\r\n======================================================== -->\r\n\r\n<div class=\"footer\">\r\n\r\n    شكراً لزيارتكم\r\n\r\n</div>\r\n\r\n\r\n</div>",
