  "html": "<style>\n@page { size: 80mm auto; margin: 0; }\nbody { font-family: 'DejaVu Sans','Arial',sans-serif; width:80mm; max-width:80mm; margin:0 auto; padding:10px; font-size:11px; line-height:1.45; }\n.text-center{text-align:center}.bold{font-weight:700}.divider{border-top:1px dashed #333;margin:10px 0}.row{display:table;width:100%;margin:4px 0}.row>span:first-child{display:table-cell;text-align:right;width:58%}.row>span:last-child{display:table-cell;text-align:left;width:42%}.item{margin:8px 0}.item-name{font-weight:700}.item-meta{display:flex;justify-content:space-between;color:#555}.total{font-size:14px;font-weight:700;border-top:2px solid #000;padding-top:7px}.paid{color:#137333}.remaining{color:#b3261e;font-weight:700}.footer{border-top:2px solid #000;margin-top:14px;padding-top:8px;text-align:center;font-size:9px}@media print{body{padding:5mm}}\n</style>\n{%- set symbol = frappe.db.get_value('Currency', doc.currency, 'symbol') or doc.currency -%}\n{%- set booking_payments = frappe.get_all('Payment Entry', filters={'custom_booking_invoice': doc.name, 'docstatus': 1, 'payment_type': 'Receive'}, fields=['paid_amount', 'base_paid_amount']) -%}\n{%- set paid = booking_payments | sum(attribute='paid_amount') -%}\n{%- if doc.party_account_currency != doc.currency and doc.currency != doc.company_currency and doc.conversion_rate -%}{%- set paid = (booking_payments | sum(attribute='base_paid_amount')) / doc.conversion_rate -%}{%- endif -%}\n<div dir=\"rtl\">\n<div class=\"text-center bold\" style=\"font-size:16px\">{{ doc.company }}</div>\n{%- set logo = frappe.db.get_value('Company', doc.company, 'company_logo') -%}\n{%- if logo %}<div class=\"text-center\"><img src=\"{{ logo }}\" style=\"max-height:42px;max-width:65mm\"></div>{% endif -%}\n<div class=\"text-center bold\" style=\"font-size:15px;margin:8px 0\">فاتورة حجز</div>\n<div><b>رقم الحجز:</b> {{ doc.name }}</div><div><b>العميل:</b> {{ doc.customer_name or doc.customer }}</div><div><b>التاريخ:</b> {{ doc.posting_date }}</div><div><b>تاريخ التسليم:</b> {{ doc.custom_delivery_date or '-' }}</div>\n<div class=\"divider\"></div>\n{%- for item in doc.items %}<div class=\"item\"><div class=\"item-name\">{{ item.item_name or item.item_code }}</div><div class=\"item-meta\"><span>{{ '%.2f'|format(item.qty) }} × {{ symbol }} {{ '%.2f'|format(item.rate) }}</span><b>{{ symbol }} {{ '%.2f'|format(item.amount) }}</b></div></div>{% endfor -%}\n<div class=\"divider\"></div>\n<div class=\"row\"><span>المجموع الفرعي:</span><span>{{ symbol }} {{ '%.2f'|format(doc.net_total) }}</span></div><div class=\"row\"><span>الضريبة:</span><span>{{ symbol }} {{ '%.2f'|format(doc.total_taxes_and_charges or 0) }}</span></div><div class=\"row total\"><span>الإجمالي:</span><span>{{ symbol }} {{ '%.2f'|format(doc.grand_total) }}</span></div><div class=\"row paid\"><span>المدفوع:</span><span>{{ symbol }} {{ '%.2f'|format(paid) }}</span></div><div class=\"row remaining\"><span>المتبقي:</span><span>{{ symbol }} {{ '%.2f'|format([doc.grand_total-paid, 0]|max) }}</span></div>\n<div class=\"footer\">شكراً لكم</div></div>",
